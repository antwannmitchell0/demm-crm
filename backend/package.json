{
  "name": "backend",
  "version": "0.0.1",
  "description": "DEMM CRM Backend Engine",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "npx prisma validate",
    "prisma:status": "npx prisma migrate status",
    "test:repo-safety": "npx ts-node test-repo-safety.ts",
    "test:refresh-concurrency": "npx ts-node test-refresh-concurrency.ts",
    "test:approval": "npx ts-node test-agent-approval-api.ts",
    "test:auth-security": "npx ts-node test-auth-security.ts",
    "test:workspace-guard": "npx ts-node test-workspace-guard-api.ts",
    "test:workspace-controller": "npx ts-node test-workspace-controller-security.ts",
    "test:e2e": "npx ts-node verify-comprehensive.ts",
    "test:http": "npx ts-node verify-http-staging.ts",
    "test:gcp": "npx ts-node verify-gcp-staging.ts",
    "verify": "npm run lint && npm run typecheck && npm run prisma:validate && npm run prisma:status && npm run test:e2e && npm run test:http && npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "test:agent-contract": "npx ts-node test-agent-contract.ts",
    "test:workspace-switching": "npx ts-node test-workspace-switching.ts",
    "test:team": "npx ts-node test-team-management.ts",
    "test:approval-inbox": "npx ts-node test-approval-inbox.ts",
    "test:team-authz": "npx ts-node test-team-authorization.ts",
    "test:invitation-migration": "npx ts-node test-invitation-migration.ts",
    "test:invitation-accept": "npx ts-node test-invitation-acceptance.ts",
    "test:token-purpose": "npx ts-node test-token-purpose.ts",
    "test:invitation-pre-session": "ts-node test-invitation-pre-session.ts",
    "test:invited-registration": "TRUSTED_PROXY_HOPS=1 ts-node test-invited-registration.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.3.1",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
